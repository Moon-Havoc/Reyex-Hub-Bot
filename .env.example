# ─────────────────────────────────────────────────────────────────────────────
# Reyex Hub BOT — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here

# Guild ID for development (guild-scoped commands update instantly).
# Remove or leave empty for global commands (can take up to 1 hour to propagate).
GUILD_ID=your_guild_id_here

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/reyex-hub
# MongoDB Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/reyex-hub

# ── Roles ─────────────────────────────────────────────────────────────────────
# Role granted to members after successful Roblox verification
VERIFIED_ROLE_ID=your_verified_role_id_here

# Staff role — grants access to moderation commands (/ban, /kick, /warn, etc.)
STAFF_ROLE_ID=your_staff_role_id_here

# Admin role — same as or higher than staff; used for admin-only commands
ADMIN_ROLE_ID=your_admin_role_id_here

# Owner role — highest trust level (optional; falls back to STAFF_ROLE_ID)
OWNER_ROLE_ID=your_owner_role_id_here

# ── Channels ──────────────────────────────────────────────────────────────────
# Channel where welcome messages are sent when a member joins.
# Falls back to the server's System Channel if not set.
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Channel where departure messages are logged when a member leaves.
# Leave empty to disable departure logging.
LEAVE_CHANNEL_ID=your_leave_channel_id_here

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
# Override the rotating status messages with a single fixed activity string.
# Leave empty to use the built-in rotating messages.
BOT_ACTIVITY=

# Set to "development" to enable debug logging and verbose error stack traces.
NODE_ENV=production
