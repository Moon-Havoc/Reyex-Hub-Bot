# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_guild_id_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/reyex-hub
# Or use MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/reyex-hub

# Bot Configuration
PREFIX=/
VERIFIED_ROLE_ID=your_verified_role_id_here
ADMIN_ROLE_ID=your_admin_role_id_here

# Roblox Configuration (Optional - for Roblox API integration)
ROBLOX_API_KEY=your_roblox_api_key_here

# Bot Status
BOT_STATUS=Online
BOT_ACTIVITY=Reyex Hub | /help

# Giveaway Configuration
GIVEAWAY_DURATION_HOURS=24
